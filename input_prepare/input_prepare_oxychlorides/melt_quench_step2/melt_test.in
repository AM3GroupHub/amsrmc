units           metal
atom_style      atomic
newton          on
boundary        p p p
read_data       disordered.data

pair_style      mliap unified /home/svu/xintian.wang/project/amorphousSSE/models/MACE-matpes-r2scan-omat-ft.model-mliap_lammps.pt 0
pair_coeff      * * Cl Li Nb O

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Groups: type 1=Cl, 2=Li, 3=Nb, 4=O
group           cl type 1
group           li type 2
group           nb type 3
group           ox type 4

compute         msd_li li msd
compute         msd_nb nb msd
compute         msd_ox ox msd
compute         msd_cl cl msd

timestep        0.002
thermo          100
thermo_style    custom step temp pe ke etotal press c_msd_li[4] c_msd_nb[4] c_msd_ox[4] c_msd_cl[4]

velocity        all create 1800.0 42 dist gaussian
fix             1 all nvt temp 1800.0 1800.0 0.1
run             100000
unfix           1

write_data      melted.data
