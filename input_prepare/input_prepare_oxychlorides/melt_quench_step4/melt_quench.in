units           metal
atom_style      atomic
newton          on
boundary        p p p
read_data       disordered.data

pair_style      mliap unified /home/svu/xintian.wang/project/amorphousSSE/models/MACE-matpes-r2scan-omat-ft.model-mliap_lammps.pt 0
pair_coeff      * * Cl Li Nb O

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.002
thermo          500
thermo_style    custom step temp pe ke etotal press vol

dump            1 all custom 5000 melt_quench.dump id type x y z

# Phase 1: Melt at 1800.0 K
velocity        all create 1800.0 42 dist gaussian
fix             1 all nvt temp 1800.0 1800.0 0.1
run             100000
unfix           1

# Phase 2: Quench from 1800.0 K to 300.0 K
fix             2 all langevin 1800.0 300.0 0.1 42
fix             3 all nve
run             75000
unfix           2
unfix           3

# Phase 3: Equilibrate at 300.0 K
fix             4 all nvt temp 300.0 300.0 0.1
run             25000
unfix           4

write_data      amorphous.data
