#!/bin/bash
# Job: melt_quench_step4
# Description: Melt-quench-equilibrate: 1800K melt, quench to 300K, equilibrate
# Job Type: custom
# Submitted: 2026-02-09 00:54

#PBS -N melt_quench_step4
#PBS -q auto
#PBS -l select=1:ngpus=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -P personal-xintian.wang

#mpi 1 omp 4

cd $PBS_O_WORKDIR
module load GCC/13.3.0
module load CUDA/12.6.0
module load OpenMPI/5.0.3-GCC-13.3.0

echo "=== Job started at $(date) ==="
eval "$(conda shell.bash hook)" && conda activate rmc && export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH && python 4_melt_quench.py
echo "=== Job finished at $(date) ==="
